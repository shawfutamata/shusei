{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasuki-line-notifications",
  "main": "workers/line-notifications.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "services": [{ "binding": "TASUKI", "service": "tasuki" }]
}
